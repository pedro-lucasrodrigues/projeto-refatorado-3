generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id    Int     @id @default(autoincrement())
  name  String
  type  String
  price Float
}

model Order {
  id        Int      @id @default(autoincrement())
  customer  String
  items     String
  total     Float
  status    String
  createdAt DateTime @default(now())
}
